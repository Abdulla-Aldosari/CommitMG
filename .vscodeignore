# Ship gpt-tokenizer (the Estimate Cost feature's runtime dependency) but not
# its esm/sources halves: out/ requires the CJS build plus the data folder.
node_modules/**
!node_modules/gpt-tokenizer/
!node_modules/gpt-tokenizer/cjs/
!node_modules/gpt-tokenizer/cjs/**
!node_modules/gpt-tokenizer/data/
!node_modules/gpt-tokenizer/data/**
!node_modules/gpt-tokenizer/package.json
