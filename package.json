{
  "name": "commitmg",
  "displayName": "Commit MG",
  "description": "A tiny VS Code extension that adds a single button to the Source Control 'Changes' toolbar to generate a commit message.",
  "version": "0.0.1",
  "publisher": "Abdulla-Aldosari",
  "author": "Abdulla Aldosari",
  "icon": "icons/icon.png",
  "homepage": "https://github.com/Abdulla-Aldosari/CommitMG#readme",
  "bugs": {
    "url": "https://github.com/Abdulla-Aldosari/CommitMG/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdulla-Aldosari/CommitMG.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitmg.insertCommitMessage",
        "title": "Generate Commit Message",
        "category": "Commit MG",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitmg.insertCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && mocha",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "git-cliff": "^2.14.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{js,ts,json,css,md}": "prettier --write"
  }
}
