{
  "name": "commitmg",
  "displayName": "Commit MG",
  "description": "A tiny VS Code extension that adds a single button to the Source Control **Changes** toolbar to generate commit message.",
  "version": "0.0.1",
  "publisher": "Abdulla-Aldosari",
  "author": "Abdulla Aldosari",
  "icon": "icons/icon.png",
  "homepage": "https://github.com/Abdulla-Aldosari/CommitMG#readme",
  "bugs": {
    "url": "https://github.com/Abdulla-Aldosari/CommitMG/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdulla-Aldosari/CommitMG.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "testExperiment.insertCommitMessage",
        "title": "Insert Test Commit Message",
        "icon": "$(note)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "testExperiment.insertCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "git-cliff": "^2.14.2",
    "typescript": "^5.4.5"
  }
}
